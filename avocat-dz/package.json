{
  "name": "maktabi",
  "version": "1.0.0",
  "private": true,
  "description": "مكتبي | Maktabi — نظام ثلاثي اللغات لتسيير مكاتب المحاماة الجزائرية | Gestion cabinets d'avocats DZ | Algerian Law Firm Management — Arabe / Français / English",
  "main": "electron/main.js",
  "author": "Maktabi <support@maktabi.dz>",
  "homepage": "https://github.com/bahaeddineragueb-oss/maktabi",
  "repository": {
    "type": "git",
    "url": "https://github.com/bahaeddineragueb-oss/maktabi.git"
  },
  "keywords": ["maktabi", "مكتبي", "avocat", "algerie", "lawyer", "cabinet", "dz"],
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:next": "next dev -H 0.0.0.0 -p 3000",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "dev:pc": "concurrently \"npm:dev:next\" \"npm:dev:electron\"",
    "build": "next build",
    "build:web": "next build",
    "build:pc": "ELECTRON=true next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "electron": "electron .",
    "electron:build": "ELECTRON=true next build && electron-builder --win --x64",
    "dist": "npm run electron:build",
    "dist:win": "ELECTRON=true next build && electron-builder --win --x64",
    "dist:portable": "ELECTRON=true next build && electron-builder --win portable --x64",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "lucide-react": "0.441.0",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7",
    "tailwind-merge": "2.5.2"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "concurrently": "9.0.1",
    "cross-env": "7.0.3",
    "electron": "30.5.1",
    "electron-builder": "24.13.3",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.40",
    "prisma": "^5.22.0",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "dz.maktabi.avocat",
    "productName": "مكتبي - Avocat DZ",
    "copyright": "Copyright © 2026 Maktabi DZ",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "public/**/*",
      "prisma/maktabi.db",
      "data/courts.json",
      "lib/courts-data.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "out"
      },
      {
        "from": "prisma/maktabi.db",
        "to": "maktabi.db"
      },
      {
        "from": "data",
        "to": "data"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "publisherName": "Maktabi DZ"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "مكتبي",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "fr_FR",
        "ar_AR"
      ]
    },
    "portable": {
      "artifactName": "Maktabi-Portable-${version}.exe"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    }
  }
}
